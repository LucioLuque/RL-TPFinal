+suave_bajada_c003_vel_tocar 1 3000000 --log_std_init -0.5
+suave_bajada_c003_vel_tocar 2 3000000 --log_std_init -0.5
+# Control: la recompensa por defecto con desvio 0.61, a 3M. Hace falta c003/c005 o alcanza con explorar menos y entrenar mas?
+suave_bajada 42 3000000 --log_std_init -0.5
+suave_bajada 1 3000000 --log_std_init -0.5
+suave_bajada 2 3000000 --log_std_init -0.5
+# c003 con desvio 0.37 (TODO.md, punto 2).

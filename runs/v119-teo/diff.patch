+  reward_descent_coef: 0.3
+  landing_vz_coef: 10.0
+  crash_penalty: 10.0
+
+suave_bajada_c003_gnd:   # c003 con efecto suelo (coeficiente de gym-pybullet-drones)
+  reward_distance_coef: 0.1
+  reward_action_coef: 0.03
+  reward_descent_coef: 0.3
+  crash_penalty: 10.0
+  ground_effect: true
+
+# Accion como velocidad (action_mode: velocity, env.py): v = 0.6 * (dx, dy, dz). Con la accion de gym-pybullet-drones,
+# s queda saturado (media ~3) y el dron va siempre a 0.6 m/s: no puede frenar sin inclinar la direccion (v105, v111).
+suave_bajada_c003_vel:
+  reward_distance_coef: 0.1
+  reward_action_coef: 0.03
+  reward_descent_coef: 0.3
+  crash_penalty: 10.0
+  action_mode: velocity
+
+suave_bajada_c003_vel_tocar:   # + premio por tocar despacio (como suave_bajada_c003_tocar)
+  reward_distance_coef: 0.1
+  reward_action_coef: 0.03
+  reward_descent_coef: 0.3
+  landing_vz_coef: 10.0
+  crash_penalty: 10.0
+  action_mode: velocity
